<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.controller.EscuelaController">

    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>

    <top>
        <VBox alignment="TOP_CENTER" spacing="15.0" BorderPane.alignment="CENTER">
            <children>
                <Label text="GESTIÓN DE INSTITUCIONES EDUCATIVAS">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="10.0" top="10.0" />
                    </VBox.margin>
                </Label>

                <GridPane hgap="15.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="10.0" prefWidth="150.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="400.0" />
                    </columnConstraints>
                    <children>
                        <Label text="Nombre del Plantel:" />
                        <TextField fx:id="txtNombre" promptText="Ej: Benito Juárez" GridPane.columnIndex="1" />

                        <Label text="Nivel Educativo:" GridPane.rowIndex="1" />
                        <ComboBox fx:id="cbNivel" prefWidth="250.0" promptText="Seleccione nivel..." GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Clave (CCT):" GridPane.rowIndex="2" />
                        <TextField fx:id="txtCodigo" promptText="Código único" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label text="Dirección:" GridPane.rowIndex="3" />
                        <TextField fx:id="txtDireccion" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label text="Matrícula Total:" GridPane.rowIndex="4" />
                        <TextField fx:id="txtMatricula" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                    </children>
                    <padding>
                        <Insets left="50.0" right="50.0" />
                    </padding>
                </GridPane>

                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Button onAction="#btnNuevo" text="Nuevo" />
                        <Button onAction="#btnGuardar" styleClass="boton-agregar" text="Guardar" />
                        <Button onAction="#btnEliminar" styleClass="boton-eliminar" text="Eliminar" />
                        <Separator orientation="VERTICAL" />
                        <Button onAction="#btnFiltrar" styleClass="boton-filtrar" text="Filtrar por Nivel" />
                        <Button onAction="#btnListarTodo" styleClass="boton-mostrar" text="Ver Todos" />
                    </children>
                    <VBox.margin>
                        <Insets bottom="10.0" top="10.0" />
                    </VBox.margin>
                </HBox>
            </children>
            <padding>
                <Insets top="10.0" />
            </padding>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tabla" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
                <TableColumn fx:id="colNivel" prefWidth="120.0" text="Nivel" />
                <TableColumn fx:id="colCodigo" prefWidth="100.0" text="CCT" />
                <TableColumn fx:id="colDireccion" prefWidth="200.0" text="Dirección" />
                <TableColumn fx:id="colMatricula" prefWidth="100.0" text="Matrícula" />
            </columns>
            <BorderPane.margin>
                <Insets bottom="20.0" left="20.0" right="20.0" />
            </BorderPane.margin>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>
</BorderPane>